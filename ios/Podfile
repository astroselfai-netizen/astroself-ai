# Resolve react_native_pods.rb with node to allow for hoisting
use_frameworks! :linkage => :static
install! 'cocoapods', :generate_multiple_pod_projects => true

require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.1'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Astroself' do
  config = use_native_modules!

  # ✅ Enable Google Maps SDK for iOS
  # pod 'GoogleMaps'
  # pod 'Google-Maps-iOS-Utils'
  
  # Firebase Crashlytics
  pod 'Firebase/Crashlytics'



# rn_maps_path = '../node_modules/react-native-maps'
# pod 'react-native-maps/Google', :path => rn_maps_path

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    # :new_arch_enabled => false,
    :hermes_enabled => true, # 👈 enable Hermes if you want
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # Xcode 26+: fmt 11.0.2 consteval fails with Apple Clang 21 (RN #55601). Use C++17 for fmt only.
    pod_projects = [installer.pods_project]
    if installer.respond_to?(:generated_projects)
      pod_projects.concat(installer.generated_projects)
    end
    pod_projects.compact.uniq.each do |project|
      project.targets.each do |target|
        next unless target.name == 'fmt'

        target.build_configurations.each do |bc|
          bc.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end

    # Patch fmt headers: Xcode 26 / Apple Clang 21 rejects fmt 11.0.2 consteval (RN #55601)
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      content = File.read(fmt_base)
      unless content.include?('Xcode 26 workaround')
        patched = content
          .gsub(
            /#elif defined\(__cpp_consteval\)\n#  define FMT_USE_CONSTEVAL 1/,
            "#elif defined(__cpp_consteval)\n#  define FMT_USE_CONSTEVAL 0  // Xcode 26 workaround",
          )
          .gsub(
            /#elif FMT_GCC_VERSION >= 1002 \|\| FMT_CLANG_VERSION >= 1101\n#  define FMT_USE_CONSTEVAL 1/,
            "#elif FMT_GCC_VERSION >= 1002 || FMT_CLANG_VERSION >= 1101\n#  define FMT_USE_CONSTEVAL 0  // Xcode 26 workaround",
          )
        if patched != content
          File.chmod(0o644, fmt_base)
          File.write(fmt_base, patched)
          Pod::UI.puts 'Patched fmt/base.h for Xcode 26 (FMT_USE_CONSTEVAL=0)'.green
        end
      end
    end

    # Fix Xcode 15/16 sandbox and non-modular includes issues for some pods (e.g., RNSVG, Hermes)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        # Ensure all pods use the same deployment target
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        # Remove arm64 exclusion for Apple Silicon Macs (allows native arm64 simulator builds)
        config.build_settings.delete("EXCLUDED_ARCHS[sdk=iphonesimulator*]")
      end
    end
  end
end